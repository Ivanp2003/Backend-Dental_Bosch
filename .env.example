# Puerto del servidor
PORT=4000

# MongoDB - Elige una URI según tu entorno
MONGODB_URI_PRODUCTION=mongodb+srv://usuario:password@cluster.mongodb.net/consultorio
MONGODB_URI_LOCAL=mongodb://localhost:27017/consultorio

# Configuración SendGrid para envío de correos
HOST_SENDGRID=smtp.sendgrid.net
PORT_SENDGRID=587
SENDGRID_API_KEY=SG.tu-api-key-aqui
EMAIL_FROM=noreply@tudominio.com

# URLs de la aplicación
URL_BACKEND=http://localhost:4000/api/
URL_FRONTEND=http://localhost:5174

# Secreto para JWT (genera uno nuevo para producción)
JWT_SECRET=TU_SECRETO_JWT_AQUI

# Cloudinary (para manejo de imágenes)
CLOUDINARY_CLOUD_NAME=tu-cloud-name
CLOUDINARY_API_KEY=tu-api-key
CLOUDINARY_API_SECRET=tu-api-secret

# Google OAuth (para autenticación con Google)
GOOGLE_CLIENT_ID=tu-google-client-id
GOOGLE_CLIENT_SECRET=tu-google-client-secret
